@model Customer
<link rel="stylesheet" type="text/css" href="~/StaticFiles/css/profile.css">
<div class="block">
    <h2>Hello, Name!</h2>
    <form action="/Home/Profile/" class="form-profile" method="post">
        <input type="text" name="name" class="profile-input" value=@Model.Name>
        <input type="email" name="email" class="profile-input" value=@Model.Email>
        <input type="password" name="password" class="profile-input" value=@Model.Password>
        <input type="submit" class="profile-input">
    </form>
</div>